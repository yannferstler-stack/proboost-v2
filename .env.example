# ─── Anthropic (AI PDF parsing & credit check) ───────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Twilio (SMS relances — plan Pro) ────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
